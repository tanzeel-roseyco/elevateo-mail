{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elevateo Mail Preview",
  "version": "0.1.0",
  "identifier": "com.elevateo.mail.preview",
  "build": {
    "beforeBuildCommand": "node src-tauri/build-preview.mjs",
    "beforeDevCommand": "node src-tauri/build-preview.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "capabilities": [{ "identifier": "draft-handoff", "local": true, "windows": ["preview"], "permissions": ["allow-prepare-draft"] }],
      "assetProtocol": { "enable": false, "scope": [] },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Offline preview with fictional email data"
  }
}
