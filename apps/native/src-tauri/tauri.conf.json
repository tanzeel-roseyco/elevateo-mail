{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elevateo Mail",
  "version": "0.1.0",
  "identifier": "com.elevateo.mail",
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Elevateo Mail",
        "width": 1120,
        "height": 760
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": false,
        "scope": []
      },
      "capabilities": []
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "nsis"
    ],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
