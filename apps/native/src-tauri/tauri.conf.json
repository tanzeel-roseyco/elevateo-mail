{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elevateo Mail",
  "version": "0.1.0",
  "identifier": "com.elevateo.mail",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [{ "label": "main", "create": false, "title": "Elevateo Mail", "width": 1120, "height": 760 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "allowDowngrades": false,
      "nsis": { "displayLanguageSelector": false, "languages": ["English"] },
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  }
}
