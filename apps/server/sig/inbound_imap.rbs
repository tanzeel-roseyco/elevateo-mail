module Net
  class IMAP
    def initialize: (String, port: Integer, ssl: Hash[Symbol, Integer | String | bool], ?open_timeout: Numeric,
      ?max_response_size: Integer, ?debug: bool) -> void
    def login: (String, String) -> untyped
    def select: (String) -> untyped
    def responses: () -> Hash[String, Array[untyped]]
    class SequenceSet
      def initialize: (String) -> void
    end
    def uid_search: (Array[String | SequenceSet]) -> Array[Integer]
    def uid_fetch: (Integer, Array[String]) -> Array[untyped]
    def disconnect: () -> untyped
    private
    def tcp_socket: (String, Integer) -> Socket
    def start_receiver_thread: () -> Thread
  end
end

module Elevateo
  module Inbound
    type imap_event = { uid: Integer, raw_mime: String }
    type imap_claim = { "binding" => MailCredentials::Binding, "uidvalidity" => Integer?, "last_uid" => Integer }
    type staged_attachment = { ordinal: Integer, filename: String, content_type: String,
      byte_size: Integer, sha256: String, storage_key: String }
    type parsed_attachment = { ordinal: Integer, filename: String, content_type: String,
      byte_size: Integer, sha256: String, bytes: String }

    interface _AttachmentStorage
      def put_once: (String, String) -> void
    end

    interface _ImapStore
      def claim: (account_id: String, credential_version: Integer) -> imap_claim
      def reset_uidvalidity: (account_id: String, credential_version: Integer,
        expected: Integer, replacement: Integer) -> bool
      def insert_once: (account_id: String, credential_version: Integer, uidvalidity: Integer, uid: Integer,
        content_sha256: String, from: String, to: Array[String], subject: String, text: String,
        attachments: Array[staged_attachment]) -> Hash[String, untyped]
    end

    interface _ImapSession
      def verified_tls?: () -> bool
      def uidvalidity: () -> Integer
      def fetch_after: (Integer, limit: Integer) -> Array[imap_event]
      def close: () -> untyped
    end

    interface _ImapTransport
      def open: (binding: MailCredentials::Binding) -> _ImapSession
    end

    class ImapIngress
      @store: _ImapStore
      @attachment_storage: _AttachmentStorage?
      def initialize: (store: _ImapStore, ?attachment_storage: _AttachmentStorage?) -> void
      def ingest: (account_id: String, credential_version: Integer, uidvalidity: Integer, uid: Integer,
        raw_mime: String) -> Hash[String, untyped]
    end

    class ImapWorkerStore
      SQL: String
      PLAIN_SQL: String
      RESET_SQL: String
      CLAIM_SQL: String
      @connection: Elevateo::WriteStatements
      @lease_token: String?
      def initialize: (connection: Elevateo::WriteStatements, ?lease_token: String?) -> void
      def insert_once: (account_id: String, credential_version: Integer, uidvalidity: Integer, uid: Integer,
        content_sha256: String, from: String, to: Array[String], subject: String, text: String,
        ?attachments: Array[staged_attachment]) -> Hash[String, untyped]
      def reset_uidvalidity: (account_id: String, credential_version: Integer,
        expected: Integer?, replacement: Integer) -> bool
      def claim: (account_id: String, credential_version: Integer) -> imap_claim
      private
      def query: (String, String, Array[String | Integer | nil]) -> ActiveRecord::Result
      def binds: (Array[String | Integer | nil]) -> Array[ActiveRecord::Relation::QueryAttribute]
    end

    class ImapSync
      @batch_full: bool
      def batch_full: () -> bool
      MAX_BATCH: Integer
      MAX_UID: Integer
      @store: _ImapStore
      @transport: _ImapTransport
      @attachment_storage: _AttachmentStorage?
      def initialize: (store: _ImapStore, transport: _ImapTransport,
        ?attachment_storage: _AttachmentStorage?) -> void
      def run: (account_id: String, credential_version: Integer) -> Integer
    end

    module ImapCleanup
      def self.reraise: (Exception, StandardError) -> bot
    end

    class ImapDeadline
      class Expired < Timeout::Error
      end
      @expires_at: Float
      def initialize: (?seconds: Integer | Float) -> void
      def remaining: () -> Float
      def call: [T] () { () -> T } -> T
    end

    class OwnedImapClient < Net::IMAP
      class CleanupFailed < StandardError
      end
      MAX_RESPONSE_BYTES: Integer
      @deadline: ImapDeadline
      @cleanup_failure: ^() -> void
      @raw_socket: Socket?
      @owned_receiver: Thread?
      def initialize: (String, port: Integer, ssl: Hash[Symbol, Integer | String | bool],
        deadline: ImapDeadline, cleanup_failure: ^() -> void) -> void
      def disconnect: () -> void
      private
      def close_socket: () -> void
      def stop_receiver: () -> void
      def tcp_socket: (String, Integer) -> Socket
      def start_receiver_thread: () -> Thread
    end

    class TlsImapTransport
      MAX_DISCOVERED_UIDS: Integer
      MAX_UID: Integer
      @host: String
      @port: Integer
      @mailbox: String
      @ca_file: String?
      @resolver: _ImapCredentialResolver
      @factory: _ImapClientFactory
      @session_timeout: Integer | Float
      @available: bool
      def initialize: (host: String, credential_resolver: _ImapCredentialResolver,
        ?port: Integer, ?mailbox: String, ?ca_file: String?, ?client_factory: _ImapClientFactory,
        ?session_timeout: Integer | Float) -> void
      def open: (binding: MailCredentials::Binding) -> Session
      class Session
        @client: Net::IMAP
        @deadline: ImapDeadline
        @cleanup_failure: ^() -> void
        @closed: bool
        def initialize: (Net::IMAP, ?deadline: ImapDeadline, ?cleanup_failure: ^() -> void) -> void
        def verified_tls?: () -> bool
        def uidvalidity: () -> Integer
        def fetch_after: (Integer, limit: Integer) -> Array[imap_event]
        def close: () -> untyped
      end
    end

    interface _ImapCredentialResolver
      def call: (MailCredentials::Binding, protocol: String) -> [String, String]
    end
    interface _ImapClientFactory
      def new: (String, port: Integer, ssl: Hash[Symbol, Integer | String | bool],
        deadline: ImapDeadline, cleanup_failure: ^() -> void) -> Net::IMAP
    end
  end
end
