module Elevateo
  module Attachments
    type scan_outcome = :idle | :scanned | :held | :failed
    class ScanConfig
      attr_reader runtime: Config
      attr_reader storage: PrivateStorage
      def self.load!: (?_ConfigEnvironment) -> ScanConfig
      def initialize: (runtime: Config, env: _ConfigEnvironment) -> void
      def inspect: () -> String
      alias to_s inspect
    end
    class ScanLoop
      @scan: ^() -> scan_counts
      @logger: ^(String) -> void
      @clock: ^() -> Float
      @sleeper: ^(Float) -> void
      @failures: Integer
      @last_outcome: scan_outcome?
      @last_log_at: Float?
      def initialize: (scan: ^() -> scan_counts, logger: ^(String) -> void,
        ?clock: ^() -> Float, ?sleeper: ^(Float) -> void) -> void
      def run: (stop: ^() -> bool, ?once: bool) -> (scan_outcome | :stopped)
      private
      def step: () -> [scan_outcome, Float]
      def failed: (:held | :failed) -> [:held | :failed, Float]
      def report: (scan_outcome, Float, Float) -> void
      def wait: (Float, ^() -> bool) -> void
    end
  end
end
