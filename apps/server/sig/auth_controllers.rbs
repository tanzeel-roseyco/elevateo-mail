module V1
  class ApiController < ApplicationController
    @api_deadline: Elevateo::RequestDeadline

    def process_action: (*untyped) -> untyped
    def api_boundary: () { () -> void } -> void
    def api_deadline: () -> Elevateo::RequestDeadline
    def api_query: (?allowed: Array[String]) -> Hash[String, String]
    def session_cookie: () -> String?
    def request_csrf: () -> String?
    def api_body: (required: Array[String], ?optional: Array[String]) -> Elevateo::auth_object
    def api_security_headers: () -> void
    def api_encode: (Elevateo::auth_value, limit: Integer) -> String
    def api_json: (Elevateo::auth_value, ?status: Integer, ?limit: Integer) -> void
    def api_serialized: (String, ?status: Integer, ?limit: Integer) -> void
    def api_error: (Elevateo::AuthError) -> void
  end

  class AuthController < ApiController
    @sessions: Elevateo::Sessions?
    @challenges: Elevateo::SessionChallenges?
    def challenge: () -> void
    def login: () -> void
    def recovery: () -> void
    def refresh: () -> void
    def logout: () -> void
    def accept: () -> void

    def sessions: () -> Elevateo::Sessions
    def auth_config: () -> Elevateo::Config
    def pending_cookie: () -> String?
    def challenges: () -> Elevateo::SessionChallenges
    def verify_challenge!: () -> bool
    def verify_logout!: () -> (bool | nil)
    def lifecycle: (Elevateo::SessionResult) -> void
    def set_auth_cookie: (String, String, max_age: Integer) -> void
    def clear_auth_cookie: (String) -> void
  end

  class SessionsController < ReadController
    def show: () -> void
    def switch_organization: () -> void
  end

  class OrganizationsController < ReadController
    def index: () -> void
  end
end

class AuthEntriesController < V1::AuthController
  def stage: () -> void
end
