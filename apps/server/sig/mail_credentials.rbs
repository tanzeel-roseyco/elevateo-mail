module Elevateo
  module MailCredentials
    class Unavailable < StandardError
    end

    class Binding
      UUID: Regexp
      @account_id: String
      @organization_id: String
      @mailbox_id: String
      @credential_version: Integer
      @credential_ref: String
      attr_reader account_id: String
      attr_reader organization_id: String
      attr_reader mailbox_id: String
      attr_reader credential_version: Integer
      attr_reader credential_ref: String
      def initialize: (account_id: String, organization_id: String, mailbox_id: String,
        credential_version: Integer, credential_ref: String) -> void
      def key: (protocol: String) -> String
    end

    class Bundle
      MAX_BYTES: Integer
      MAX_ENTRIES: Integer
      KEYS: Array[String]
      @entries: Hash[String, [String, String]]
      def initialize: (path: String) -> void
      def call: (Binding, protocol: String) -> [String, String]
      def inspect: () -> String
      alias to_s inspect
      private
      def read_private: (String) -> String
      # AIDEV-NOTE: Untyped exists only at the parsed JSON boundary; add validates every field before insertion.
      def add: (untyped) -> void
      class UniqueObject < Hash[String, untyped]
        def []=: (String, untyped) -> untyped
      end
    end
  end
end
