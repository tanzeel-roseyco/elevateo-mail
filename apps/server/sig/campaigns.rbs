module Elevateo
  module Campaigns
    class Input
      attr_reader kind: String
      attr_reader id: String
      attr_reader operation_id: String
      attr_reader attributes: Hash[String, untyped]
      FIELDS: Hash[String, Array[String]]
      def initialize: (kind: String, value: Hash[String, untyped]) -> void
      def label: (untyped, Integer) -> String
      def enum: (untyped, Array[String]) -> String
      def self.email: (untyped) -> String
    end
  end
end

module Elevateo
  module Campaigns
    class Repository
      @connection: _ThreadConnection
      def initialize: (connection: _ThreadConnection) -> void
      def save: (Input, organization_id: String) -> String
      def suppress: (organization_id: String, email: String, reason: String) -> String
      def analytics: (organization_id: String, campaign_id: String) -> Hash[String, untyped]
      def timestamp: (untyped) -> String?
      def rows: (String, Array[untyped]) -> Array[Hash[String, untyped]]
    end
  end
end

module Elevateo
  module Campaigns
    class Repository
      def page: (kind: String, organization_id: String, ?campaign_id: String?, ?cursor: String?, ?limit: Integer) -> Hash[String, untyped]
      def detail: (kind: String, organization_id: String, id: String) -> Hash[String, untyped]
      def replace: (Input, organization_id: String, expected_version: Integer, ?actor_id: String?, ?intent: Hash[String, untyped]?, ?preserve_consent: bool) -> Hash[String, untyped]
      def selection_for: (String) -> String
      def account_mailbox_visible: () -> String
      def table_for: (String) -> String
      def project: (String, Hash[String, untyped]) -> Hash[String, untyped]
    end
  end
end

module Elevateo
  module Campaigns
    class RunInput
      FIELDS: Array[String]
      @operation_id: String
      @mailbox_id: String
      @expected_version: Integer
      @subject: String
      @body_text: String
      @lead_ids: Array[String]
      @digest: String
      attr_reader operation_id: String
      attr_reader mailbox_id: String
      attr_reader expected_version: Integer
      attr_reader subject: String
      attr_reader body_text: String
      attr_reader lead_ids: Array[String]
      attr_reader digest: String
      def initialize: (Hash[String, untyped]) -> void
      private
      def text: (untyped, Integer) -> String
    end
    class Runs
      @repository: Repository
      @database: SendAPI::Database
      @drafts: DraftOperations
      @sends: SendAPI::Service
      @identity: SessionIdentity
      @outbound_mode: String
      @epoch: String?
      def initialize: (connection: _ThreadConnection, session: auth_object, identity: SessionIdentity, outbound_mode: String, epoch: String?) -> void
      def create: (String, RunInput, request_id: String) -> Hash[String, untyped]
      def list: (String, ?cursor: String?) -> Hash[String, untyped]
      def detail: (String, String) -> Hash[String, untyped]
      def cancel: (String, String) -> Hash[String, untyped]
      private
      def eligible: (String, Array[String]) -> Array[Hash[String, untyped]]
      def queue_recipient: (String, RunInput, Hash[String, untyped], String) -> untyped
    end
  end
end
