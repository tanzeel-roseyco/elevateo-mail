module Elevateo
  module ResendWebhook
    class Invalid < StandardError
    end
    class Verifier
      TOLERANCE: Integer
      @key: String
      @clock: ^() -> Integer
      def initialize: (secret: String, ?clock: ^() -> Integer) -> void
      def verify!: (id: String, timestamp: String, signatures: String, body: String) -> bool
      private
      def secure_compare: (String, String) -> bool
    end
    class Handler
      TYPES: Array[String]
      @connection: _SessionConnection
      @binder: ^(String?) -> ActiveRecord::Relation::QueryAttribute
      def initialize: (connection: _SessionConnection,
        ?binder: (^(String?) -> ActiveRecord::Relation::QueryAttribute)?) -> void
      def ingest: (id: String, body: String) -> auth_object
      private
      def bind: (String?) -> ActiveRecord::Relation::QueryAttribute
    end
  end
end
module V2
  class ResendProviderEventsController < ApplicationController
    def create: () -> void
  end
end
