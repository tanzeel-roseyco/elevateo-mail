module Elevateo
  module SendWorker
    class SmtpTransport
      class Held < StandardError
      end
      @profile: SmtpProfile
      @client: untyped
      def initialize: (profile: SmtpProfile, ?client: untyped) -> void
      def database_profile: () -> String
      def submit: (String, send_id: String, attempt_id: String, deadline: CallDeadline) -> SubmissionResult
      def observation: (send_id: String, attempt_id: String, snapshot_digest: String, ?snapshot_bytes: String?) -> nil
    end
    class LocalMailpitClient
      class PreflightFailed < StandardError
      end
      @profile: SmtpProfile
      @smtp_factory: untyped
      def initialize: (profile: SmtpProfile, ?smtp_factory: untyped) -> void
      def deliver: (RenderedMessage, deadline: CallDeadline) -> SubmissionResult
    end
  end
end
