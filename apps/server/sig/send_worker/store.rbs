module Elevateo
  module SendWorker
    class Claim
      attr_accessor send_id: String
      attr_accessor lease_id: String
      attr_accessor generation: Integer
      attr_accessor action: String
      attr_accessor attempt_id: String?
      attr_accessor snapshot_digest: String?
      def initialize: (send_id: String, lease_id: String, generation: Integer, action: String, ?attempt_id: String?, ?snapshot_digest: String?) -> void
    end
    class Authorization
      attr_accessor attempt_id: String
      attr_accessor snapshot_bytes: String
      def initialize: (attempt_id: String, snapshot_bytes: String) -> void
    end
    class Store
      @connection: untyped
      @lease_seconds: Integer
      @deadline_seconds: Integer
      @snapshots: Hash[String, String]
      def initialize: (connection: untyped, ?lease_seconds: Integer, ?deadline_seconds: Integer) -> void
      def claim: (epoch: String) -> Claim?
      def authorize_submission: (claim: untyped, epoch: String) -> Authorization?
      def final_check: (claim: untyped, attempt_id: String, epoch: String) -> bool
      def record_observation: (claim: untyped, attempt_id: String, snapshot_digest: String, result: SubmissionResult) -> untyped
      def mark_unknown: (claim: untyped, attempt_id: String, reason: String) -> untyped
      def reconcile: (claim: untyped, observation: SubmissionResult?) -> untyped
      private
      def persist: (untyped, String, String, SubmissionResult) -> untyped
      def object: (String, Array[untyped]) -> Hash[String, untyped]
    end
  end
end
