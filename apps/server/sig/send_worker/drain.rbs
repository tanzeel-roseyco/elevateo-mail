module Elevateo
  module SendWorker
    class Drain
      @connection: untyped
      @control: Control
      @driver: DurableLocalDriver
      @max_steps: Integer
      @max_seconds: Numeric
      @idle_delay: Float
      @clock: ^() -> Float
      @sleeper: ^(Float) -> void
      def initialize: (connection: untyped, control: Control, driver: DurableLocalDriver,
        ?max_steps: Integer, ?max_seconds: Numeric, ?idle_delay: Float,
        ?clock: ^() -> Float, ?sleeper: ^(Float) -> void) -> void
      def run: () -> Integer
    end
  end
end
