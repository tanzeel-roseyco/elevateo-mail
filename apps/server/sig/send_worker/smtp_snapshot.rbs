module Elevateo
  module SendWorker
    class SmtpSnapshot
      MAX_MIME_BYTES: Integer
      MAX_BODY_CHARS: Integer
      FORMAT: String
      class Invalid < StandardError
      end
      def self.render: (String, send_id: String, verified_sender: String) -> RenderedMessage
      def self.parse_recipients: (untyped) -> Array[[String?, String]]
      def self.build_mime: (String, RenderedMessage) -> String
      def self.encoded_words: (String) -> String
    end
  end
end
