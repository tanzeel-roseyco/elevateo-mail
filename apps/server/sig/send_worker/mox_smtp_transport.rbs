module Elevateo
  module SendWorker
    class MoxSmtpTransport
      @profile: SmtpProfile
      @ca_file: String
      @credential_resolver: ^(String) -> [String, String]
      @smtp_factory: ^(String, Integer) -> Net::SMTP
      def initialize: (profile: SmtpProfile, ca_file: String, credential_resolver: ^(String) -> [String, String],
        ?smtp_factory: ^(String, Integer) -> Net::SMTP) -> void
      def submit: (String, send_id: String, attempt_id: String, deadline: CallDeadline) -> SubmissionResult
      # AIDEV-NOTE: No SMTP lookup exists; accept the driver's String keywords without consuming them.
      def observation: (**String) -> nil
      private
      def deliver: (RenderedMail, send_id: String, attempt_id: String, deadline: CallDeadline) -> SubmissionResult
    end
  end
end
