module Elevateo
  module OutreachSequence
    module Schedule
      UUID: Regexp
      LOCAL_AT: Regexp
      MAX_VERSION: Integer

      def self.due_utc: (local_at: untyped, timezone: untyped) -> Time?
      def self.due_after: (anchor_utc: untyped, delay_seconds: untyped, local_time: untyped, timezone: untyped) -> Time?
      def self.occurrence_key: (campaign_id: untyped, lead_id: untyped, step_id: untyped, draft_version: untyped) -> String
      def self.stop_decision: (campaign_id: untyped, lead_id: untyped, events: untyped) -> Symbol
      def self.stop_required?: (reply_at: untyped, unsubscribe_at: untyped) -> bool

      private
      def due_utc: (local_at: untyped, timezone: untyped) -> Time?
      def due_after: (anchor_utc: untyped, delay_seconds: untyped, local_time: untyped, timezone: untyped) -> Time?
      def occurrence_key: (campaign_id: untyped, lead_id: untyped, step_id: untyped, draft_version: untyped) -> String
      def stop_decision: (campaign_id: untyped, lead_id: untyped, events: untyped) -> Symbol
      def stop_required?: (reply_at: untyped, unsubscribe_at: untyped) -> bool
    end
  end
end
