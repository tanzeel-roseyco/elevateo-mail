#!/usr/bin/env ruby
# Idle worker: validates configuration and holds; the heartbeat proves loop liveness only.
require_relative "../config/environment"
require_relative "../lib/elevateo/heartbeat"
cfg = Elevateo::Config.current
raise Elevateo::ConfigError, "worker requires outbound hold" unless cfg.outbound_hold
$stdout.sync = true
puts({ event: "worker.idle", outbound_hold: cfg.outbound_hold, dispatch: "disabled" }.to_json)
stop = false
%w[TERM INT].each { |s| Signal.trap(s) { stop = true } }
Elevateo::Heartbeat.publish
until stop
  sleep 1
  Elevateo::Heartbeat.publish
end
