#!/usr/bin/env ruby
# Idle worker: validates configuration, verifies its restricted DB login, and holds.
require_relative "../config/environment"
cfg = Elevateo::Config.current
raise Elevateo::ConfigError, "worker requires outbound hold" unless cfg.outbound_hold
$stdout.sync = true
puts({ event: "worker.idle", outbound_hold: cfg.outbound_hold, dispatch: "disabled" }.to_json)
stop = false
%w[TERM INT].each { |s| Signal.trap(s) { stop = true } }
File.write("/tmp/worker.alive", Time.now.to_i.to_s)
until stop
  sleep 1
  File.write("/tmp/worker.alive", Time.now.to_i.to_s)
end
