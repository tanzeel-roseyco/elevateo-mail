#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "pg"
require_relative "../lib/elevateo/config"
require_relative "../lib/elevateo/send_worker/executor"
require_relative "../lib/elevateo/send_worker/database_store"
require_relative "../lib/elevateo/send_worker/durable_local_driver"
require_relative "../lib/elevateo/send_worker/drain"

cfg = Elevateo::Config.load!
raise Elevateo::ConfigError, "send worker requires isolated worker role" unless cfg.db_role == "elevateo_worker"
raise Elevateo::ConfigError, "send worker requires explicit control" if cfg.send_control_path.empty?
raise Elevateo::ConfigError, "send worker requires outbound hold profile" unless cfg.outbound_hold
mailpit_test = ARGV.first == "--mailpit-test"
target, option = mailpit_test ? ARGV.drop(1) : ARGV
unless ARGV.length == (mailpit_test ? 3 : 2) &&
    (mailpit_test ? Elevateo::SendWorker::Control.valid_epoch?(target) :
      (target == "--drain" || Elevateo::SendWorker::Control.valid_epoch?(target))) &&
    (mailpit_test || Elevateo::SendWorker::DurableLocalDriver::OUTCOMES.include?(option))
  raise ArgumentError, "usage: send-worker SEND_UUID|--drain accept|reject|accept_then_timeout|pause " \
    "OR send-worker --mailpit-test SEND_UUID sender@example.invalid"
end
profile = mailpit_test ? "mailpit-smtp-test-v1" : "synthetic-v1"
driver = if mailpit_test
  require_relative "../lib/elevateo/send_worker/smtp_transport"
  Elevateo::SendWorker::SmtpTransport.new(profile: Elevateo::SendWorker::SmtpProfile.local_mailpit(verified_sender: option))
else
  Elevateo::SendWorker::DurableLocalDriver.new(path: ENV.fetch("ELEVATEO_LOCAL_ACCEPTANCE_LEDGER"), outcome: option)
end

# AIDEV-NOTE: Drain reads only worker-scoped due IDs; every submission still needs a fenced SQL claim.
connection = PG.connect(host: cfg.db_host, dbname: cfg.db_name, user: cfg.db_role, password: cfg.db_password)
begin
  connection.exec("SET statement_timeout = '3s'")
  connection.exec("SET lock_timeout = '1s'")
  control = Elevateo::SendWorker::Control.new(path: cfg.send_control_path)
  if target == "--drain"
    steps = Elevateo::SendWorker::Drain.new(connection: connection, control: control, driver: driver).run
    puts JSON.generate(event: "send_worker.drain", steps: steps, simulated: true)
  else
    store = Elevateo::SendWorker::DatabaseStore.new(connection: connection, send_id: target, profile: profile)
    outcome = Elevateo::SendWorker::Executor.new(store: store, driver: driver, control: control).run_once
    puts JSON.generate(event: "send_worker.step", send_id: target, result: outcome, simulated: true)
  end
ensure
  connection.close
end
