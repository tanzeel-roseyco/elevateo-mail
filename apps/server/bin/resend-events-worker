#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require_relative "../lib/elevateo/heartbeat"
require "active_record"
require_relative "../lib/elevateo/config"
require_relative "../lib/elevateo/attachments_worker_storage"
require_relative "../lib/elevateo/resend_events/client"
require_relative "../lib/elevateo/resend_events/worker"

# AIDEV-NOTE: Separate worker credentials own provider retrieval; webhook HTTP only authenticates and persists bytes.
class ResendEventsConnection < ActiveRecord::Base
  self.abstract_class = true
end

stopping = false
%w[INT TERM].each { |signal| Signal.trap(signal) { stopping = true } }
exit_code = 0
begin
  raise ArgumentError, "invalid arguments" unless [["--once"], ["--run"]].include?(ARGV)
  cfg = Elevateo::Config.load!
  raise Elevateo::ConfigError, "Resend worker profile required" unless
    cfg.outbound_mode == "resend" && cfg.process == "worker" && cfg.db_role == "elevateo_worker"
  client = Elevateo::ResendEvents::Client.new(api_key: cfg.resend_api_key)
  storage = Elevateo::Attachments::WorkerStorage.load!(ENV)
  ResendEventsConnection.establish_connection(adapter: "postgresql", host: cfg.db_host, database: cfg.db_name,
    username: cfg.db_role, password: cfg.db_password, pool: 1, checkout_timeout: 5, connect_timeout: 5,
    variables: { statement_timeout: "3s", lock_timeout: "1s" })
  failures = 0
  Elevateo::Heartbeat.publish
  until stopping
    begin
      outcome = ResendEventsConnection.connection_pool.with_connection do |connection|
        raise Elevateo::ConfigError, "database role mismatch" unless connection.select_value("SELECT session_user") == "elevateo_worker"
        Elevateo::ResendEvents::Worker.new(store: Elevateo::ResendEvents::Store.new(connection: connection),
          client: client, storage: storage).run_once
      end
      failures = 0
      delay = outcome == "empty" ? 1.0 : 0.05
    rescue StandardError
      # AIDEV-NOTE: Provider exceptions contain presigned URLs and message bytes; log only a fixed status.
      failures = [failures + 1, 6].min
      outcome, delay = "failed", [2.0**(failures - 1), 30.0].min
    end
    puts JSON.generate(event: "resend_events.poll", result: outcome) unless outcome == "empty"
    Elevateo::Heartbeat.publish
    if ARGV == ["--once"]
      exit_code = 1 if outcome == "failed"
      break
    end
    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + delay
    sleep(0.1) until stopping || Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline
  end
rescue StandardError
  warn JSON.generate(event: "resend_events.startup_failed")
  exit_code = 1
ensure
  begin
    ResendEventsConnection.remove_connection
  rescue StandardError
    warn JSON.generate(event: "resend_events.cleanup_failed")
    exit_code = 1
  end
end
exit(exit_code)
