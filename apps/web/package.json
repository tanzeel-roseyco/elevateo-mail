{
  "name": "@elevateo/web",
  "private": true,
  "version": "0.1.0-read.1",
  "type": "module",
  "description": "Elevateo Mail web client \u00e2\u20ac\u201d FE-01 read checkpoint. Session, mailboxes, thread list and plaintext reader only.",
  "scripts": {
    "dev": "vite",
    "dev:fixtures": "vite --mode fixtures",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "generate:api": "openapi-typescript ../../contracts/v1/openapi.json --output src/data/generated/api.d.ts",
    "check:api": "openapi-typescript ../../contracts/v1/openapi.json --output src/data/generated/api.d.ts --check",
    "generate:api:v2": "openapi-typescript ../../contracts/v2/openapi.json --output src/data/generated/api-v2.d.ts",
    "check:api:v2": "openapi-typescript ../../contracts/v2/openapi.json --output src/data/generated/api-v2.d.ts --check"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
