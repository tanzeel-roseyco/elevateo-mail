{
  "name": "Elevateo Mail",
  "short_name": "Elevateo",
  "description": "Read and manage your mail with Elevateo Mail.",
  "id": "/",
  "scope": "/",
  "start_url": "/#/inbox",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "lang": "en",
  "icons": [
    { "src": "/brand/pwa-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/brand/pwa-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/brand/pwa-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "/brand/pwa-desktop.png", "sizes": "1440x900", "type": "image/png", "form_factor": "wide", "label": "Elevateo Mail sign-in on desktop" },
    { "src": "/brand/pwa-mobile.png", "sizes": "390x844", "type": "image/png", "form_factor": "narrow", "label": "Elevateo Mail sign-in on mobile" }
  ],
  "shortcuts": [
    { "name": "Inbox", "url": "/#/inbox", "icons": [{ "src": "/brand/pwa-192.png", "sizes": "192x192" }] },
    { "name": "Search", "url": "/#/search", "icons": [{ "src": "/brand/pwa-192.png", "sizes": "192x192" }] }
  ]
}
