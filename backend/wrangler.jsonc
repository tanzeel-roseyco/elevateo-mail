{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "elevateo-mail-backend-disabled",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "PROVIDER_MODE": "fake", "LIVE_SENDING": "disabled", "DISPATCH_PAUSED": "true" },
  "d1_databases": [{ "binding": "DB", "database_name": "elevateo-mail-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "elevateo-mail-local" }],
  "queues": {
    "producers": [{ "binding": "SEND_QUEUE", "queue": "elevateo-mail-local-send" }],
    "consumers": [{ "queue": "elevateo-mail-local-send", "max_batch_size": 10, "max_retries": 3 }]
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
