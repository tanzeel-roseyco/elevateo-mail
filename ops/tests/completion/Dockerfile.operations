# AIDEV-NOTE: Trusted final-gate harness only; Docker socket access never enters application/runtime images.
ARG SERVER_IMAGE
ARG DOCKER_IMAGE
FROM ${DOCKER_IMAGE} AS docker_cli
FROM ${SERVER_IMAGE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3 openssl age openssh-client \
    && rm -rf /var/lib/apt/lists/*
COPY --from=docker_cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker_cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
COPY ops/ /ops/
WORKDIR /ops/production
ENTRYPOINT ["python3"]
CMD ["-m", "unittest", "discover", "-s", "completion", "-p", "test_*.py"]
