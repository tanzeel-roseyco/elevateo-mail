# Example keys for an isolated Docker test project. Replace placeholders privately.
# Do not source this file unchanged. Never put live provider keys here.
RAILS_ENV=test
ELEVATEO_MODE=local
ELEVATEO_SEND_API_ENABLED=false
ELEVATEO_OUTBOUND_HOLD=true
ELEVATEO_PROCESS=api
ELEVATEO_DB_HOST=db
ELEVATEO_DB_NAME=postgres
ELEVATEO_DB_ROLE=elevateo_api
API_DB_PASSWORD=REPLACE_IN_PRIVATE_FILE
ELEVATEO_AUTH_URL=http://auth:9999
ELEVATEO_STORAGE_URL=http://storage:5000
ELEVATEO_MAILPIT_URL=http://mailpit:8025
ELEVATEO_SMTP_HOST=mailpit
ELEVATEO_SMTP_PORT=1025
SECRET_KEY_BASE=REPLACE_IN_PRIVATE_FILE
ELEVATEO_SESSION_KEY_BASE64=REPLACE_IN_PRIVATE_FILE
ELEVATEO_BROWSER_ORIGIN=http://api:3000
ELEVATEO_COOKIE_SECURE=false
ELEVATEO_LOCAL_HTTP=true
ELEVATEO_AUTH_JWT_ISSUER=http://127.0.0.1:18310
ELEVATEO_AUTH_JWT_AUDIENCE=authenticated
ELEVATEO_AUTH_JWT_ALGORITHM=HS256
ELEVATEO_AUTH_PASSWORD_MINIMUM=12
