# AIDEV-NOTE: example only; derive real values into a private 0600 file on a disposable test network.
# The gateway gets one restricted DB login, a gateway-only Storage token and no API DB credential.
ELEVATEO_PROCESS=attachment_gateway
ELEVATEO_DB_NAME=postgres
ELEVATEO_ATTACHMENT_GATEWAY_DATABASE_URL=postgres://elevateo_attachment_gateway:REPLACE_PRIVATE_HEX@db:5432/postgres
ELEVATEO_ATTACHMENT_GATEWAY_HMAC_KEY_BASE64=REPLACE_PRIVATE_BASE64
ELEVATEO_STORAGE_URL=http://storage:5000
ELEVATEO_ATTACHMENT_BUCKET=REPLACE_PRIVATE_BUCKET
ELEVATEO_ATTACHMENT_STORAGE_SERVICE_TOKEN=REPLACE_PRIVATE_TEST_TOKEN
ELEVATEO_SEND_API_ENABLED=false
ELEVATEO_OUTBOUND_HOLD=true
