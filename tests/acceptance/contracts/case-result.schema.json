{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app.test/contracts/acceptance/case-result-v1",
  "title": "Acceptance case record v1",
  "$comment": "Structural schema. shared/schema.ts additionally enforces elapsed time, retry identity, profile/lane and status relations; T4 must apply both.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "dispatch_id", "lane", "transport_profile", "scenario_path_id", "partition", "framework_test_id", "test_file", "implementation_mode", "attempt", "attempt_id", "retry_of", "started_at", "ended_at", "duration_ms", "status", "reason", "authority_variant", "assertions", "evidence", "artifacts"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "$ref": "#/$defs/id" }, "dispatch_id": { "$ref": "#/$defs/id" },
    "lane": { "enum": ["unit", "database", "real_auth_api", "playwright_real", "playwright_mock", "puppeteer_cdp", "selenium", "native_platform"] },
    "transport_profile": { "enum": ["fixture", "internal_http", "tls", "native"] },
    "scenario_path_id": { "type": "string", "pattern": "^SCN-[A-Z][A-Z0-9]{1,19}-[0-9]{3}-(P|F1|F2)$" },
    "partition": { "$ref": "#/$defs/text" }, "framework_test_id": { "$ref": "#/$defs/text" },
    "test_file": { "$ref": "#/$defs/path" },
    "implementation_mode": { "enum": ["real", "mock", "simulated"] },
    "attempt": { "type": "integer", "minimum": 0, "maximum": 20 },
    "attempt_id": { "$ref": "#/$defs/attemptId" },
    "retry_of": { "anyOf": [{ "$ref": "#/$defs/attemptId" }, { "type": "null" }] },
    "started_at": { "$ref": "#/$defs/time" }, "ended_at": { "$ref": "#/$defs/time" },
    "duration_ms": { "type": "number", "minimum": 0, "maximum": 86400000 },
    "status": { "enum": ["passed", "failed", "not_run", "blocked", "skipped"] },
    "reason": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
    "authority_variant": { "$ref": "#/$defs/text" },
    "assertions": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/text" } },
    "evidence": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/text" } },
    "artifacts": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$" },
    "attemptId": { "type": "string", "maxLength": 160, "pattern": "^SCN-[A-Z][A-Z0-9]{1,19}-[0-9]{3}-(P|F1|F2)\\.[a-z_]+\\.[0-9]{1,2}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^[^\u0000-\u0008\u000b-\u001f\u007f]*$" },
    "time": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 240,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*(/[a-zA-Z0-9][a-zA-Z0-9._-]*)*$",
      "allOf": [
        { "not": { "pattern": "\\.(/|$)" } },
        { "not": { "pattern": "(^|/)([cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][0-9]|[lL][pP][tT][0-9])(\\.|/|$)" } }
      ]
    }
  }
}
