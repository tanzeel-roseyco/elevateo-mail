{
  "name": "elevateo-acceptance",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": "24.21.0" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node --test \"dist/contracts/*.spec.js\" \"dist/playwright/*.unit.spec.js\" \"dist/puppeteer/*.unit.spec.js\" \"dist/selenium/*.unit.spec.js\" \"dist/proxy/*.spec.js\"",
    "test:playwright": "playwright test --config playwright/playwright.config.ts",
    "test:diagnostics": "playwright test --config diagnostics.config.ts",
    "test:transport": "playwright test --config transport.config.ts",
    "test:puppeteer": "node dist/puppeteer/run.js",
    "test:selenium": "node dist/selenium/run.js"
  },
  "dependencies": {
    "zod": "4.6.7",
    "@playwright/test": "1.64.1",
    "puppeteer-core": "25.16.0",
    "selenium-webdriver": "4.51.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/selenium-webdriver": "4.35.7",
    "typescript": "7.0.2"
  }
}
