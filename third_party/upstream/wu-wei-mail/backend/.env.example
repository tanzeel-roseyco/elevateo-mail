# Database
DATABASE_URL=postgresql+asyncpg://wuweimail:wuweimail@localhost:5432/wuweimail

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT — CHANGE IN PRODUCTION
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Encryption for secrets at rest (SMTP passwords, OAuth tokens, AI API keys)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# OAuth — Google (see docs/oauth-setup.md)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/oauth/google/callback

# OAuth — Microsoft (see docs/oauth-setup.md)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/oauth/microsoft/callback
# For Google-only launch, keep all Microsoft values empty.

# CORS
FRONTEND_URL=http://localhost:3000
# Comma-separated allowlist for browser origins.
CORS_ORIGINS=http://localhost:3000

# App
APP_NAME=Wu Wei Mail
DEBUG=true
BASE_URL=http://localhost:8000

# Webhook / tracking security
WEBHOOK_SIGNING_SECRET=
CLICK_SIGNING_SECRET=

# AI (OpenRouter) — used by auto-responder and prospecting
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_MAX_TOKENS=2000
OPENROUTER_APP_NAME=Wu Wei Mail
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_TIMEOUT_SECONDS=45

# Tools
SERPER_API_KEY=
ANYMAILFINDER_API_KEY=

# Feature flags
PROSPECTING_ENABLED=true
PROSPECTING_EXTERNAL_INSTANTLY_ENABLED=false
WARMUP_ENABLED=false
WARMUP_PROVIDER=mailreach
MAILREACH_API_KEY=
