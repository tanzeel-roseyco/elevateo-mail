#!/bin/sh
# AIDEV-NOTE: Advertise only existing Compose services; seed/check have no maintained implementation.
set -eu
cd "$(dirname "$0")/.."
dc() { docker compose -f compose.yaml --env-file ops/local/.env "$@"; }
case "${1:-}" in
  bootstrap) docker compose -f ops/compose.secrets.yaml run --rm secrets
             dc build api && dc up -d --wait db && dc run --rm bootstrap ;;
  up)        dc up -d --wait db auth rest storage mailpit api worker ;;
  migrate)   dc run --rm migrate ;;
  stop)      dc stop ;;
  *) echo "usage: scripts/dev {bootstrap|up|migrate|stop}" >&2; exit 2 ;;
esac
