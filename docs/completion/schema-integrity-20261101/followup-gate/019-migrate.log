-- execute("-- AIDEV-NOTE: Read projections expose no object keys, tokens or digests; current compose ownership is always required.\nCREATE FUNCTION app.list_draft_attachments(p_mailbox uuid, p_draft uuid) RETURNS jsonb\nLANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path = pg_catalog, app, app_drafts_private AS $$\nDECLARE\n  v_org uuid := app.context_uuid('app.org_id');\n  v_actor uuid := app.context_uuid('app.user_id');\n  v_items jsonb;\nBEGIN\n  IF p_mailbox IS NULL OR p_draft IS NULL THEN RETURN jsonb_build_object('code', 'request_invalid'); END IF;\n  IF NOT app.draft_scope(p_mailbox, p_draft) OR NOT EXISTS (SELECT 1 FROM app.drafts\n    WHERE id = p_draft AND organization_id = v_org AND mailbox_id = p_mailbox AND actor_id = v_actor) THEN\n    RETURN jsonb_build_object('code', 'not_available');\n  END IF;\n  SELECT COALESCE(jsonb_agg(jsonb_build_object('id', attachment.id, 'filename', operation.filename,\n    'content_type', operation.content_type, 'byte_size', operation.byte_size,\n    'status', attachment.scan_status) ORDER BY attachment.created_at, attachment.id), '[]'::jsonb)\n    INTO v_items FROM app.draft_attachments attachment\n    JOIN app_drafts_private.attachment_stage_operations operation ON operation.attachment_id = attachment.id\n    WHERE attachment.organization_id = v_org AND attachment.mailbox_id = p_mailbox\n      AND attachment.draft_id = p_draft AND attachment.actor_id = v_actor AND operation.stage_state = 'committed';\n  RETURN jsonb_build_object('items', v_items);\nEND\n$$;\n")
