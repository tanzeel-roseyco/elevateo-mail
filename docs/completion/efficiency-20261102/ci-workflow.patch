       - run: npm ci --no-audit --no-fund
-      - run: npm run lint
-      - run: npm run typecheck
-      - run: npm run check:api
-      - run: npm run check:api:v2
-      - run: npm test
+      - if: matrix.check == 'lint'
+        run: npm run lint
+      - if: matrix.check == 'typecheck'
