# Environment only. Never commit a populated copy. Empty required fields refuse deployment.
# AIDEV-NOTE: deploy.sh does not source this file; export through the operator's secret manager.
ELEVATEO_PRODUCTION_IMAGE=
ELEVATEO_MCP_IMAGE=
ELEVATEO_OPERATIONS_IMAGE=
ELEVATEO_BACKUP_HELPER_IMAGE=
POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
REST_DB_PASSWORD=
STORAGE_DB_PASSWORD=
MIGRATOR_DB_PASSWORD=
API_DB_PASSWORD=
WORKER_DB_PASSWORD=
ATTACHMENT_GATEWAY_DB_PASSWORD=
SECRET_KEY_BASE=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
ELEVATEO_SESSION_KEY_BASE64=
ELEVATEO_ATTACHMENT_GATEWAY_HMAC_KEY_BASE64=
ELEVATEO_AUTHENTIK_ISSUER=
ELEVATEO_AUTHENTIK_GROUP=
ELEVATEO_AUTHENTIK_API_TOKEN=
ELEVATEO_AUTHENTIK_CLIENT_ID=
ELEVATEO_AUTHENTIK_CLIENT_SECRET=
ELEVATEO_ATTACHMENT_BUCKET=
ELEVATEO_MCP_HTTP_HOST=
ELEVATEO_MOX_HOSTNAME=
ELEVATEO_MOX_IPV4=
ELEVATEO_MAIL_DOMAINS=
ELEVATEO_WORKSPACE_DOMAINS=
ELEVATEO_MOX_TLS_CERT_BASE64=
ELEVATEO_MOX_TLS_KEY_BASE64=
ELEVATEO_APPROVED_ASSIGNMENTS=
ELEVATEO_EGRESS_ID=
ELEVATEO_OUTBOUND_MODE=held
ELEVATEO_OUTBOUND_HOLD=true
ELEVATEO_PROVISIONING_ENABLED=false
ELEVATEO_MAILBOX_DAILY_SEND_LIMIT=30
ELEVATEO_USER_DAILY_SEND_LIMIT=300
# Required only for mode=resend. Sending remains held.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
ELEVATEO_RESEND_FROM_DOMAIN=
# Backup/recovery operation environment (not supplied to application containers).
COMPOSE_FILE=
COMPOSE_PROJECT_NAME=elevateo-production
ELEVATEO_SOURCE_REVISION=
# Required by deployment and backup/recovery to serialize operations.
ELEVATEO_OPERATIONS_LOCK=
ELEVATEO_BACKUP_AGE_RECIPIENT=
ELEVATEO_BACKUP_SSH_HOST=
ELEVATEO_BACKUP_REMOTE_DIR=
ELEVATEO_BACKUP_SSH_KEY_BASE64=
ELEVATEO_BACKUP_KNOWN_HOSTS=
# Recovery only; keep separate from the online backup identity.
ELEVATEO_BACKUP_AGE_IDENTITY_BASE64=
