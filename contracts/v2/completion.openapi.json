    "/v2/provider-events/resend": {
      "post": {
        "operationId": "receiveResendProviderEvent",
        "x-elevateo-status": "existing",
        "security": [],
        "description": "Authenticate Svix HMAC of id.timestamp.raw-body within 300 seconds. Persist idempotently before 204; conflicting duplicate bytes return 409. Maximum raw body 262144 bytes. Provider additions never grant authority.",
        "parameters": [
          {
            "name": "svix-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 124,
              "minLength": 1,
              "pattern": "^msg_[A-Za-z0-9_-]{1,120}$(?![\\s\\S])"
            }
          },
          {
            "name": "svix-timestamp",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 12,
              "minLength": 1,
              "pattern": "^[0-9]{1,12}$(?![\\s\\S])"
            }
          },
          {
            "name": "svix-signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 1024,
              "minLength": 1
            },
            "description": "Space-separated version,base64 pairs; at least one v1 HMAC must match."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderEvent"
              },
              "example": {
                "type": "email.delivered",
                "created_at": "2026-10-29T00:00:00Z",
                "data": {
                  "email_id": "example-provider-id"
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Durably accepted or identical replay"
          },
          "400": {
            "description": "Invalid signature, timestamp, size or payload; empty body"
          },
          "409": {
            "description": "Event ID reused with conflicting bytes; empty body"
          },
          "503": {
            "description": "Durable storage unavailable; empty body. Retry using the same Svix event ID."
          }
        }
      }
    },
