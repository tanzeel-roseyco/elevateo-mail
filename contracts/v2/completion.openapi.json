              "auth": {
                "type": "boolean"
              },
              "storage": {
                "type": "boolean"
              },
              "mail_catcher": {
                "type": "boolean"
              }
            },
            "required": [
              "database",
              "auth",
              "storage",
              "mail_catcher"
            ]
          }
        },
        "required": [
          "status",
          "outbound_hold",
          "checks"
        ]
