            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "put": {
        "operationId": "updateOutreachLead",
        "x-elevateo-status": "active",
        "parameters": [
          {
            "name": "campaign_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Id"
            }
          },
          {
            "name": "lead_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeadUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current tenant-scoped inert metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeadSummary"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/v2/outreach/campaigns/{campaign_id}/analytics": {
      "get": {
        "operationId": "getOutreachAnalytics",
        "x-elevateo-status": "active",
        "parameters": [
          {
            "name": "campaign_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current tenant-scoped inert metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CampaignAnalytics"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/v2/outreach/campaigns/{campaign_id}/accounts": {
      "get": {
        "operationId": "listOutreachAccounts",
        "x-elevateo-status": "disabled",
        "description": "Requires current mailbox visibility and campaign scope; never activates the account.",
        "parameters": [
          {
            "name": "campaign_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Id"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current visible disabled accounts only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountPage"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/v2/outreach/campaigns/{campaign_id}/accounts/{account_id}": {
      "get": {
        "operationId": "getOutreachAccount",
        "x-elevateo-status": "disabled",
        "parameters": [
          {
            "name": "campaign_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Id"
            }
          },
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current visible disabled accounts only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountSummary"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "elevateo_session"
      },
      "workerPrincipal": {
        "type": "mutualTLS"
      }
    },
    "parameters": {
      "OrganizationId": {
        "name": "organization_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/Id"
        }
      },
      "UserId": {
        "name": "user_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/Id"
        }
      },
      "JobId": {
        "name": "job_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/Id"
        }
      }
    },
    "responses": {
      "Forbidden": {
        "description": "Current authority denied"
      },
      "Conflict": {
        "description": "Expected revision stale or authority changed"
      }
    },
    "schemas": {
      "UtcTimestamp": {
        "type": "string",
        "format": "date-time",
        "pattern": "Z$"
      },
      "Address": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "display_name",
          "address"
        ],
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          },
          "address": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Message": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sender",
          "to",
          "sent_at",
          "body_text",
          "body_truncated",
          "attachment_count"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Id"
          },
          "sender": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Address"
              },
              {
                "type": "null"
              }
            ]
          },
          "to": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Address"
            }
          },
          "sent_at": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UtcTimestamp"
              },
              {
                "type": "null"
              }
            ]
          },
          "body_text": {
            "type": "string",
            "maxLength": 16384
          },
          "body_truncated": {
            "type": "boolean"
          },
          "attachment_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        }
      },
      "DirectMessagePage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "context_id",
          "authorization_version",
          "mailbox_id",
          "thread_id",
          "message"
        ],
        "properties": {
          "context_id": {
            "type": "string",
            "minLength": 16,
            "maxLength": 256
          },
          "authorization_version": {
            "type": "string",
            "minLength": 16,
            "maxLength": 256
          },
          "mailbox_id": {
            "$ref": "#/components/schemas/Id"
          },
          "thread_id": {
            "$ref": "#/components/schemas/Id"
          },
          "message": {
            "$ref": "#/components/schemas/Message"
          }
        }
      },
      "Id": {
        "type": "string",
        "format": "uuid"
      },
      "OrganizationGrant": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "organization_id",
          "user_id",
          "role",
          "revision"
        ],
        "properties": {
          "organization_id": {
            "$ref": "#/components/schemas/Id"
          },
          "user_id": {
            "$ref": "#/components/schemas/Id"
          },
          "role": {
            "enum": [
              "organization_owner",
              "organization_admin",
              "technology_operator",
              "sales_lead",
              "sales_member",
              "security_auditor",
              "organization_member"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "GrantChange": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "expected_revision"
        ],
        "properties": {
          "role": {
            "enum": [
              "organization_admin",
              "technology_operator",
              "sales_lead",
              "sales_member",
              "security_auditor",
              "organization_member"
            ]
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "CampaignSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "status",
          "version"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "status": {
            "enum": [
              "draft",
              "paused"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      },
      "CampaignPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "next_cursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/CampaignSummary"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "OutreachPlan": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "operation_id",
          "name",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Id"
          },
          "operation_id": {
            "$ref": "#/components/schemas/Id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "status": {
            "enum": [
              "draft",
              "paused"
            ]
          }
        }
      },
      "WorkerJob": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Id"
          },
          "status": {
            "enum": [
              "queued",
              "leased",
              "completed",
              "failed"
            ]
          }
        }
      },
      "OrganizationGrantPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "context_id",
          "authorization_version",
          "actor",
          "items",
          "next_cursor"
        ],
        "properties": {
          "context_id": {
            "type": "string",
            "minLength": 16,
            "maxLength": 256
          },
          "authorization_version": {
            "type": "string",
            "minLength": 16,
            "maxLength": 256
          },
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/OrganizationGrant"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2048
          },
          "actor": {
            "$ref": "#/components/schemas/OrganizationGrant"
          }
        }
      },
      "RosterPerson": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "display_name",
          "title",
          "department",
          "enrollment_state"
        ],
        "properties": {
          "key": {
            "type": "string",
