              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Current tenant-scoped inert metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeadSummary"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/v2/outreach/campaigns/{campaign_id}/leads/{lead_id}": {
      "get": {
        "operationId": "getOutreachLead",
        "x-elevateo-status": "active",
        "parameters": [
          {
            "name": "campaign_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Id"
            }
          },
          {
            "name": "lead_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current tenant-scoped inert metadata",
            "content": {
              "application/json": {
