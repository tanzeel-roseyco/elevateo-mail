{
  "openapi": "3.1.1",
  "info": {
    "title": "Elevateo additive administration and inert outreach API",
    "version": "2.0.0-draft.3",
    "description": "V1 schemas unchanged. Admin and inert outreach operations are isolated integration candidates pending fleet security validation; worker status remains disabled."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/v2/threads/{thread_id}/messages/{message_id}": {
      "get": {
        "operationId": "getDirectMessage",
        "x-elevateo-status": "active",
        "description": "One authorized plaintext message in the requested mailbox and thread; absent and inaccessible are indistinguishable.",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Id"
            }
          },
          {
            "name": "message_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Id"
            }
          },
          {
            "name": "mailbox_id",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current scoped plaintext message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DirectMessagePage"
                }
              }
            }
          },
          "400": {
            "description": "Malformed path or query"
          },
          "404": {
            "description": "Message absent or inaccessible"
          }
        }
      }
    },
    "/v2/organizations/{organization_id}/grants": {
      "get": {
        "operationId": "listOrganizationGrants",
        "x-elevateo-status": "candidate",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Redacted grants",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganizationGrantPage"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/v2/organizations/{organization_id}/grants/{user_id}": {
      "put": {
        "operationId": "replaceOrganizationGrant",
        "x-elevateo-status": "candidate",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          },
          {
            "$ref": "#/components/parameters/UserId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GrantChange"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated subordinate grant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganizationGrant"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/v2/outreach/campaigns": {
      "get": {
        "operationId": "listOutreachCampaigns",
        "x-elevateo-status": "active",
        "description": "Authenticated tenant-scoped inert campaign summaries; no send capability.",
        "responses": {
          "200": {
            "description": "Current inert campaign summaries",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CampaignPage"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        },
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ]
      },
      "post": {
        "operationId": "createOutreachCampaign",
        "x-elevateo-status": "active",
        "description": "Proposed idempotent inert plan creation; no dispatch.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OutreachPlan"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Current tenant-scoped inert metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CampaignSummary"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/v2/worker/jobs/{job_id}": {
      "get": {
        "operationId": "getWorkerJob",
        "x-elevateo-status": "disabled",
        "description": "Internal worker principal only; never a browser session.",
        "security": [
          {
            "workerPrincipal": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/JobId"
          }
        ],
        "responses": {
          "200": {
            "description": "Redacted job state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkerJob"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/v2/organizations/{organization_id}/roster": {
      "get": {
        "operationId": "getOrganizationRoster",
        "x-elevateo-status": "candidate",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Unbound display configuration only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RosterPage"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/v2/outreach/campaigns/{campaign_id}": {
      "get": {
        "operationId": "getOutreachCampaign",
        "x-elevateo-status": "active",
        "parameters": [
          {
            "name": "campaign_id",
