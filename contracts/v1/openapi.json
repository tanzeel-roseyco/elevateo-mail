    "/v1/mailboxes/{mailbox_id}/threads": {
      "get": {
        "operationId": "listThreads",
        "description": "Current-authorized mailbox thread summaries. Stable keyset order: last_message_at descending, null last, then id descending. Cursor binds actor, organization, session context, authorization version, mailbox, filter, ordering and limit. Does not mark read.",
        "parameters": [
