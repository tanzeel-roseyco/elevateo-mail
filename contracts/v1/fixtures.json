  "scenarios": [
    {
      "id": "stale_mailbox",
      "steps": [
        "Start mailbox A request",
        "Switch to mailbox B and increment request generation",
        "Resolve A success or error"
      ],
      "expect": "Neither response nor error mutates B state."
    },
    {
      "id": "stale_session",
      "steps": [
        "Start actor A request",
        "Replace context with session_b",
        "Resolve A success or 401"
      ],
      "expect": "No A data appears and old A 401 does not clear current B state."
    },
    {
      "id": "current_unauthenticated",
      "steps": [
        "Render session_a mail",
        "Current request returns unauthenticated"
      ],
      "expect": "Clear sensitive state, abort outstanding requests, show session-unavailable UI."
    },
    {
      "id": "authorization_changed",
      "steps": [
        "Send old authorization version",
        "Return context_changed",
        "Re-bootstrap exactly once"
      ],
      "expect": "No old data retained; repeated mismatch requires explicit retry."
    },
    {
      "id": "cursor_recovery",
      "steps": [
        "Request a scoped page with expired/mismatched cursor",
        "Return cursor_invalid",
        "Retry first page once retaining filter"
      ],
      "expect": "No repeated recovery loop; no fabricated offset."
    },
    {
      "id": "non_enumeration",
      "steps": [
        "Request nonexistent thread",
        "Request inaccessible thread"
      ],
      "expect": "Identical status/code/message and UI; no foreign content."
    },
    {
      "id": "transport_failures",
      "steps": [
        "Return malformed/wrong-content-type/oversized/redirected response or exceed timeout"
      ],
      "expect": "Deliberate bounded client error, no fallback to fixtures and no partial data."
    },
    {
      "id": "hostile_plaintext",
      "steps": [
        "Render thread_hostile_plaintext"
      ],
      "expect": "Inert visible strings; no script, HTML, Markdown, autolink, image or attachment load."
    },
    {
      "id": "separate_pagination",
      "steps": [
        "Load summary continuation",
        "Load message continuation in selected thread"
      ],
      "expect": "Independent scoped cursors; detail continuation does not replace list cursor."
    },
    {
      "id": "production_failure",
      "steps": [
        "Load production entrypoint",
        "Make API unavailable"
      ],
      "expect": "Unavailable UI; no fixture modules/data in bundle or fixture fallback."
    }
  ],
